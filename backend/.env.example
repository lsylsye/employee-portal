# 로컬 실행용. 이 파일을 backend/.env 로 복사해서 값을 채운다. (.env 는 커밋하지 않는다)
# 필수 값은 기본값이 없어서, 빠지면 기동 시점에 "Could not resolve placeholder" 로 실패한다.

# DB (필수)
PGHOST=localhost
PGPORT=5432
PGDATABASE=employee_portal
PGUSER=
PGPASSWORD=

# 외부 Background Check API 후보자 키 (필수). 로그·응답에 남기지 않는다.
BGCHECK_API_KEY=

# 제출용 계정 (기동 시 없으면 생성, 있으면 건드리지 않음). 비워 두면 만들지 않는다.
ADMIN_PASSWORD=
SUBMISSION_EMPLOYEE_NO=EMP-003
SUBMISSION_EMPLOYEE_PASSWORD=
