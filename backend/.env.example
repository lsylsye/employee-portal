# 로컬 실행용. 이 파일을 backend/.env 로 복사해서 값을 채운다. (.env 는 커밋하지 않는다)
# Homebrew Postgres 는 macOS 사용자 이름으로 슈퍼유저가 만들어진다 ('postgres' 계정 없음).
PGHOST=localhost
PGPORT=5432
PGDATABASE=employee_portal
PGUSER=
PGPASSWORD=

# 제출용 계정 (기동 시 없으면 생성, 있으면 건드리지 않음). 비워 두면 만들지 않는다.
ADMIN_PASSWORD=
SUBMISSION_EMPLOYEE_NO=EMP-003
SUBMISSION_EMPLOYEE_PASSWORD=
